APP_NAME="SI-KESA API"
APP_ENV=local
APP_TIMEZONE=Asia/Jakarta
# BIARKAN KOSONG: terdeteksi otomatis dari lokasi public/index.php (XAMPP maupun php -S)
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=si_kesa
DB_USER=root
DB_PASS=

# WAJIB diisi string acak panjang (min 32 karakter); jangan commit .env
JWT_SECRET=
JWT_TTL_INTERNAL=28800
JWT_TTL_WALI=3600

# Rate limit login Wali: percobaan gagal per NISN / per IP dalam satu jendela (detik)
RATE_LIMIT_WALI_MAX=5
RATE_LIMIT_WALI_MAX_IP=20
RATE_LIMIT_WALI_WINDOW=300
# Rate limit login Admin/Guru
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_MAX_IP=30
RATE_LIMIT_LOGIN_WINDOW=300

# Daftar origin dipisah koma; ganti * dengan origin PWA/website saat produksi
CORS_ALLOWED_ORIGINS=*
